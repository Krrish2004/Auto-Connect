{
  "manifest_version": 3,
  "name": "Auto Connect",
  "version": "1.1",
  "description": "Auto login to college WiFi only when needed.",
  "permissions": ["storage", "scripting", "tabs", "alarms"],
  "host_permissions": ["https://172.22.2.6/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://172.22.2.6/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}